fraudPrevention.title = Fraud prevention header checks
fraudPrevention.heading = Fraud prevention header checks
fraudPrevention.back = Back to API requests
fraudPrevention.intro = These checks use every request logged for this application, across all periods and clients.
fraudPrevention.meta.application = Application name
fraudPrevention.meta.environment = Environment
fraudPrevention.meta.requests = Requests checked
fraudPrevention.meta.withoutHeaders = Requests without header fields
fraudPrevention.noHeaders = None of the requests logged for this application carry fraud prevention header fields. Import log lines that include govClientPublicIP, govVendorPublicIP, govClientDeviceID, govClientLocalIPs and govVendorLicenseIDs.
fraudPrevention.allPassed = All fraud prevention header checks passed.
fraudPrevention.warning.fallback = Warning
fraudPrevention.checks.heading = Checks
