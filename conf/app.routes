# Routes
# This file defines all application routes (Higher priority routes first)

GET         /                                              controllers.HomeController.onPageLoad()

GET         /login                                         controllers.AuthController.showLogin(continue: Option[String] ?= None)
POST        /login                                         controllers.AuthController.submitLogin(continue: Option[String] ?= None)
GET         /sign-out                                      controllers.AuthController.signOut()

GET         /dashboard                                     controllers.DashboardController.onPageLoad(appId: Option[UUID] ?= None, month: Option[String] ?= None, client: Option[String] ?= None)
GET         /dashboard/import                              controllers.ImportController.onPageLoad()
POST        /dashboard/import/paste                        controllers.ImportController.submitPaste()
POST        /dashboard/import/upload                       controllers.ImportController.submitUpload()
GET         /dashboard/export/pdf                          controllers.PdfController.exportPdf(appId: UUID, month: String, client: Option[String] ?= None)
GET         /dashboard/:appId/endpoint/:endpointKey        controllers.EndpointDetailController.onPageLoad(appId: UUID, endpointKey: String, month: Option[String] ?= None, client: Option[String] ?= None)
GET         /dashboard/:appId/fraud-prevention-headers     controllers.FraudPreventionController.onPageLoad(appId: UUID)

->          /hmrc-frontend                                 hmrcfrontend.Routes
GET         /assets/*file                                  controllers.Assets.versioned(path = "/public", file: Asset)
